# Q^2 reproduction environment — CUDA 12.6 build for Ada / Ampere GPUs.
#
# Hosts: NVIDIA RTX 4090 (Ada, sm_89), 3090/4090-class (Ampere/Ada, sm_86/sm_89),
# and any driver >= 525 (CUDA 12.x runtime). The cu126 wheel index is the shared
# denominator that runs on:
#   * the 2x RTX 4090 server  (driver 565 -> CUDA 12.7 max)
#   * a CUDA 13 host (driver 595, forward-compatible with cu126 binaries)
# Use THIS image on the 4090 box. The sibling `Dockerfile` (cu128) targets
# Blackwell sm_120 (RTX 5060 Ti) and will NOT start on GeForce Ada/Ampere GPUs
# without a forward-compat license.
#
# Build (on the 4090 server):
#   docker build -t qat-repro-cu126 -f docker/Dockerfile.cu126 .
#
# Run (see scripts/docker_run.sh with PLATFORM=cu126):
#   PLATFORM=cu126 scripts/docker_run.sh python -c "import torch; \
#     print(torch.__version__, torch.cuda.is_available(), \
#           torch.cuda.get_device_capability(0))"

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# System deps + Python 3.11
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv python3-pip \
        git wget curl unzip vim ca-certificates \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && python -m pip install --upgrade pip

# PyTorch with CUDA 12.6 wheels (Ada sm_89 / Ampere sm_86; also loads on a
# CUDA 13 host via the CUDA minor-version forward compatibility of the driver).
# Let pip resolve the compatible torch/torchvision pair for cu126.
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cu126

# Project Python deps (yolov5 pins the official ultralytics/yolov5 package so
# we use the real DetectionModel/parse_model/ComputeLoss, no reimplementation).
RUN pip install \
        numpy scipy opencv-python-headless \
        pycocotools tqdm pyyaml matplotlib pandas requests psutil \
        pytest einops \
        yolov5==7.0.14

WORKDIR /workspace
CMD ["bash"]
